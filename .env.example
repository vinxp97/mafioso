# Live Dev API (only read when MAFIOSO_LIVE=1). Never commit real values.
# Windows Docker: copy this file to .env and fill the blanks. Compose defaults to dry-run.
# MAFIOSO_LIVE=1
# Dev API. VPS (Ultimafia on the same machine): http://127.0.0.1:3000
# Windows Docker talking to hosted dev: https://dev.ultimafia.gg
# DEV_API_BASE_URL=http://127.0.0.1:3000
# DEV_API_CLIENT_ID=
# DEV_API_CLIENT_SECRET=
# DEV_SETUP_ID=                 # required to host; or set GAME_ID to join a game you already opened
# GAME_ID=
# BOT_COUNT=9
# MAFIOSO_LLM=lmstudio          # lmstudio | experiential | opencode | openrouter
# MAFIOSO_EVOLVE=1              # after the game, ask Qwen for a child system prompt
# MAFIOSO_ARENA_GAMES=0         # offline games used to keep that child. 0 stores it without an arena gate.
# MAFIOSO_ARENA_SEED=1          # same seeds for the current prompt and the candidate
# MAFIOSO_ARENA_MARGIN=0        # candidate must beat the baseline by more than max(margin, noise)
# PROMPT_EPSILON=0.2            # chance a bot explores a random prompt lineage
# PROMPT_TEMPERATURE=0.5
# MAFIOSO_TRANSPORT=stream      # stream (SSE) or poll
# Cloudflare Access service token, only if the PC still hits an Access wall. Never commit.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Pick one model backend. All four are OpenAI Chat Completions.
# Placeholders only. Never commit a real key.

# LM Studio (local Qwen). From Docker Desktop on Windows use host.docker.internal, not 127.0.0.1.
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# On the host, without Docker: http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=            # empty = first id from GET /v1/models
# LM_API_KEY=lm-studio        # any non-empty string; LM Studio does not check it

# Experiential Labs — https://platform.experientiallabs.ai/docs/openai-compatibility
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# EXPLABS_MODEL=qwen3.8-27b
# EXPLABS_API_KEY=            # xpl_... from the platform; leave blank in git

# OpenCode Go — https://opencode.ai/docs/go/
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=kimi-k2.6   # also mimo-v2.5, glm-5.1, ...
# OPENCODE_API_KEY=          # leave blank in git
# OPENCODE_SESSION=          # optional; one stable id per bot run. Generated if empty.

# OpenRouter — https://openrouter.ai/docs/api/reference/overview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash
# OPENROUTER_API_KEY=        # leave blank in git
# OPENROUTER_HTTP_REFERER=   # optional HTTP-Referer; leave unset to omit the header
# OPENROUTER_TITLE=          # optional X-Title; leave unset, or set mafioso
# OPENROUTER_REASONING=low   # OpenRouter reasoning.effort (default low). MiniMax requires it.
#                            # off|none|0|false to omit. exclude stays true unless MAFIOSO_TRACE_REASONING=1.
# MAFIOSO_TRACE=1            # JSONL under logs/traces/<gameId>/<seat>.jsonl. Off when unset.
# MAFIOSO_TRACE_DIR=         # logs root. Default is logs/traces. The Mac app defaults to ~/mafioso-mac/logs.
# MAFIOSO_TRACE_REASONING=1  # OpenRouter exclude:false. Chain-of-thought is written to the trace only, never chat.
